if (!(Test-Path .gitignore)) {
    New-Item .gitignore -ItemType File
}

if (-not (Select-String -Path .gitignore -Pattern '^\s*\.env\s*$' -Quiet)) {
    Add-Content .gitignore "`n.env"
}

